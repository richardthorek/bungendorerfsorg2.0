{
  "name": "bungendore-rfs-web-2",
  "version": "1.0.0",
  "description": "Bungendore Rural Fire Service website - providing community fire safety information and engagement",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prestart": "node replace-token.js",
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint public/js public/sw.js server.js replace-token.js",
    "lint:fix": "eslint public/js public/sw.js server.js replace-token.js --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "build": "npm run lint && npm run test:coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "axe http://localhost:3000 --exit"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/data-tables": "^13.3.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "fire-service",
    "emergency-services",
    "rural-fire-service",
    "community-safety"
  ],
  "author": "Bungendore Rural Fire Service",
  "license": "MIT"
}
