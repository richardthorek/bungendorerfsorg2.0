secrets.env
node_modules
.env
.env.local
.env.*.local
RFS-Style-Guide.md

# Azure Functions / Static Web Apps local secrets (api/local.settings.example.json is tracked)
api/local.settings.json
infra/parameters.json

# Test coverage
coverage/
.nyc_output/

# IDE
# .vscode/ is intentionally tracked (settings.json, extensions/launch/tasks configs help
# rebuild a working dev environment after a reset) — only ignore machine-local overrides here.
.vscode/*.local.json
.idea/

# Claude Code personal/machine-specific overrides (shared .claude/settings.json is tracked)
.claude/settings.local.json

# Claude Code worktrees — local scratch checkouts, never meant to be committed.
# Previously three of these landed in the index as broken gitlinks (no
# .gitmodules entry), which failed `git submodule update --init` in the
# Azure Static Web Apps deploy workflow on every PR. See WEBSITE_ROADMAP.md
# PR history if this regresses.
.claude/worktrees/

# macOS artifacts
.DS_Store
__MACOSX/

# Windows artifacts
Thumbs.db

# Editor swap files
*.swp
*.swo

# npm/yarn debug logs
npm-debug.log*
yarn-error.log*
*.log

# Backup files
*~
*.bak
.scratch
