{
  "routes": [
    { "route": "/admin", "rewrite": "/admin.html" },
    { "route": "/admin.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/Images/*", "/css/*", "/js/*", "/Content/*", "/api/*", "/admin*"]
  }
}
