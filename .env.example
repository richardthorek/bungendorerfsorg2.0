# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Contact form → Azure Communication Services Email
# ACS_CONNECTION_STRING: from the "stationkit-comm" Communication Services resource (Keys blade)
# ACS_SENDER_ADDRESS:    a verified MailFrom address on notify.bungendorerfs.org
# CONTACT_NOTIFY_TO:     committee distribution list (comma-separate for several recipients)
# CONTACT_NOTIFY_CONFIRM: "false" to skip the acknowledgement email to the enquirer (default: true)
ACS_CONNECTION_STRING=endpoint=https://stationkit-comm.australia.communication.azure.com/;accesskey=xxx
ACS_SENDER_ADDRESS=contact@notify.bungendorerfs.org
CONTACT_NOTIFY_TO=committee@example-distribution-list.org
CONTACT_NOTIFY_CONFIRM=true

# Members' area (public/admin.html)
# AUTH_JWT_SECRET:            >= 32 random chars; signs the 1-hour session cookie
# BRFS_STORAGE_CONNECTION:    connection string for the storage account holding the
#                            members / sign-in-code / audit tables (brfsstorage in prod;
#                            the Azurite dev string below works with `npx azurite`)
# AUTH_ALLOWED_EMAIL_DOMAIN:  only this domain may sign in (default rfs.nsw.gov.au)
# AUTH_SESSION_MINUTES:       session length (default 60)
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BRFS_STORAGE_CONNECTION=UseDevelopmentStorage=true
AUTH_ALLOWED_EMAIL_DOMAIN=rfs.nsw.gov.au
AUTH_SESSION_MINUTES=60
# DUTY_LOOKUP_KEY: if set, GET /api/duty requires header "X-Duty-Key: <value>"
# (the Twilio flow sends it). Leave unset locally.
DUTY_LOOKUP_KEY=

# Azure Logic Apps Webhook URLs
# These should be regenerated via Azure Portal for security
AZURE_CALENDAR_WEBHOOK_URL=https://prod-xx.australiaeast.logic.azure.com/workflows/xxx/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=xxx&sv=1.0&sig=xxx
AZURE_INCIDENTS_WEBHOOK_URL=https://prod-xx.australiaeast.logic.azure.com/workflows/xxx/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=xxx&sv=1.0&sig=xxx
AZURE_FIRE_DANGER_WEBHOOK_URL=https://prod-xx.australiaeast.logic.azure.com/workflows/xxx/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=xxx&sv=1.0&sig=xxx

# Optional comma-separated origin allow-list used by /mapbox-token
ALLOWED_ORIGINS=https://bungendorerfs.org,https://www.bungendorerfs.org,http://localhost:3000

# Server Configuration
PORT=3000
